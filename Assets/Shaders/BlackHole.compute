
#pragma kernel CSMain

RWTexture2D<float4> g_Output;

TextureCube<float4> g_EnvTex;
SamplerState sampler_g_EnvTex;

Texture2D<float4> g_AccretionDiskGradient;
SamplerState my_linear_clamp_sampler;

Texture2D<float3> g_AccretionDiskTex;
SamplerState sampler_g_AccretionDiskTex;
float g_AccretionDiskSpeed;

float g_Zoom;
float g_AspectRatio;
float g_Time;

uint g_CameraResX;
uint g_CameraResY;

float3 g_CameraPos;

// Miller's Planet is outside the accretion disk
float3 g_PlanetPosition;
#define kPlanetSize 10.0f

Texture2D<float3> g_PlanetTex;

// Unity built-in
float4x4 unity_CameraToWorld;

// Here we simulate a theoretical Schwarzschild black hole. This is a uncharged, non-rotating, spherically symmetric mass.
// In reality, all (Kerr) black holes rotate slower or faster.
// The initial spin rate of a black hole is caused by the conservation of the residual angular momentum of the colapsed stellar core.
// After that, the spin rate can change dramatically.

// For non-rotating black holes, the Schwarzschild radius and the event horizon are the same (Rs = 2*G*M/c^2)
// For Earth this would be 9 mm and for the biggest known black holes this is 194 billion km.
#define kRs 100.0f

// Variable-step RK4: step = lerp(kStepMin, kStepMax, saturate((r - 1.5*Rs) / (kAccretionEnd - 1.5*Rs))).
// Rays past kMaxRadius sample the cubemap directly; kMaxSteps is the safety budget.
#define kStepMin        1.0f
#define kStepMax        35.0f
#define kMaxRadius      2000.0f
#define kMaxSteps       500

// In this simulation, the accretion disk is "artificially" generated for art purposes only and for better observing the gravitational lens effect.
#define kAccretionStart 200.0f
#define kAccretionEnd 750.0f

// If path transmittance is lower than this value then we consider that the accumulated color is "opaque" and integrations is stopped
#define kTransmittanceLowerThreshold 0.005f

// Debug mode to replace the accretion disk texture sample with a per mip color palette, interpolated by lod.
// This allows visualizing the footprint-based LOD in the absence of anisotropic filtering in compute shaders.
// Set to 0 to restore the real texture sample.
#define kDebugDiskLodColors 0

#define PI 3.141592653f

float RaySphereIntersect(float3 rayOrig, float3 rayDir, float3 spherePos, float radius)
{
    rayOrig = rayOrig - spherePos;
    float a = dot(rayDir, rayDir);
    float b = 2 * dot(rayOrig, rayDir);
    float c = dot(rayOrig, rayOrig) - radius * radius;
    float delta2 = b * b - 4 * a * c;
    float t = -1;

    if (delta2 >= 0)
    {
        float sqrtD = sqrt(delta2);
        float tNear = (-b - sqrtD) / (2 * a);
        float tFar  = (-b + sqrtD) / (2 * a);

        t = (tNear >= 0) ? tNear : tFar;
        if (t < 0)
            t = -1;
    }

    return t;
}

void SampleAccretionDisk(float3 pos, float3 prevPos, inout float3 color, inout float transmittance)
{
    // Check if we crossed y = 0 plane
    // If signs are the same it means the position are on the same side of the plane y = 0)
    if (pos.y * prevPos.y > 0)
        return;

    // Calculate t where y is 0
    // Linear interpolation: 0 = prevPos.y + t * (pos.y - prevPos.y) -> t = -prevPos.y / (pos.y - prevPos.y)
    float dY = pos.y - prevPos.y;

    // Avoid dividing by 0?
    if (abs(dY) < 1e-6f)
        return;

    float t = -prevPos.y / dY;

    // Find the intersection point
    float3 hitPoint = prevPos + (pos - prevPos) * t;
    float hitDist = length(hitPoint);

    // Check if the intersection is outside the accretion disk bounds
    if (hitDist < kAccretionStart || hitDist > kAccretionEnd)
        return;

    // Get a radial v coordinate. Map v between 0.0 (kAccretionStart) and 1.0 (kAccretionEnd)
    float v = (hitDist - kAccretionStart) / (kAccretionEnd - kAccretionStart);

    float4 diskColorGradient = g_AccretionDiskGradient.SampleLevel(my_linear_clamp_sampler, float2(v, 0), 0);

    // Get an u coordinate between 0 and 1 from the azimuthal angle of the Schwarzschild coords -PI < phi < PI
    float u = 0.5 + atan2(hitPoint.z, hitPoint.x) / (2 * PI);

    float2 uv = float2(g_AccretionDiskSpeed + u, v);

    // Footprint-based LOD (substitute for unavailable anisotropic filtering in compute).
    // Approximate the world-space size of a pixel at the disk hit, project it into UV
    // texels along the radial (v) and tangential (u) axes, and pick the larger axis.

    // Vertical slope subtended by one pixel.
    float pixelAngular = 2.0f * g_Zoom / (float) g_CameraResY;

    // Straight line distance from camera to disk hit.
    float distHit = length(hitPoint - g_CameraPos);

    // Ray vs disk normal cosine + floor to avoid grazing blowup
    float cosGraze = max(abs(normalize(pos - prevPos).y), 0.05f);

    // Pixel's world-space footprint on the disk plane
    float footprintWorld = pixelAngular * distHit / cosGraze;

    // Mip-0 texel counts for u and v
    float2 texSize;
    g_AccretionDiskTex.GetDimensions(texSize.x, texSize.y);

    // Tangential footprint in texels (circumference 2*PI*r maps to texSize.x)
    float du = footprintWorld / (2.0f * PI * hitDist) * texSize.x;

    // Radial footprint in texels (disk radial span maps to texSize.y).
    float dv = footprintWorld / (kAccretionEnd - kAccretionStart) * texSize.y;

    // Log2 of the fat-axis footprint = trilinear mip level.
    float lod = 0.5f * log2(max(du * du, dv * dv));

#if kDebugDiskLodColors
    // Per-mip debug colors
    static const float3 kLodPalette[8] =
    {
        float3(1.0f, 0.0f, 0.0f),
        float3(1.0f, 0.5f, 0.0f),
        float3(1.0f, 1.0f, 0.0f),
        float3(0.0f, 1.0f, 0.0f),
        float3(0.0f, 1.0f, 1.0f),
        float3(0.0f, 0.0f, 1.0f),
        float3(1.0f, 0.0f, 1.0f),
        float3(1.0f, 1.0f, 1.0f)
    };
    float lodClamped = clamp(lod, 0.0f, 7.0f);
    int lod0 = (int)floor(lodClamped);
    int lod1 = min(lod0 + 1, 7);

    float3 accretionDisk = lerp(kLodPalette[lod0], kLodPalette[lod1], lodClamped - lod0);

    float transparency = 1;
#else
    float3 accretionDisk = g_AccretionDiskTex.SampleLevel(sampler_g_AccretionDiskTex, uv, lod).rgb;

    accretionDisk.rgb *= diskColorGradient.rgb;

    float alpha = diskColorGradient.a;
    alpha *= dot(float3(0.299f, 0.587f, 0.114f), accretionDisk);

    float transparency = saturate(alpha);
#endif

    color += accretionDisk.rgb * transparency * transmittance;
    transmittance *= (1 - transparency);
}

void SampleMillersPlanet(float3 pos, float3 prevPos, inout float3 color, inout float transmittance)
{
    float3 rayDir = pos - prevPos;
    float rayDirLength = length(rayDir);

    // Quick test
    if (dot(pos - g_PlanetPosition, pos - g_PlanetPosition) > (kPlanetSize + rayDirLength) * (kPlanetSize + rayDirLength))
        return;

    rayDir = rayDir / rayDirLength;

    float t = RaySphereIntersect(prevPos, rayDir, g_PlanetPosition, kPlanetSize);

    if (t == -1)
        return;

    float3 worldSpacePos = prevPos + rayDir * t;
    float3 localSpacePos = worldSpacePos - g_PlanetPosition;
    float3 normal = normalize(localSpacePos);

    // Compute some fake lighting
    float3 lightColor = float3(1.0f, 0.4f, 0.1f);

    lightColor *= max(0, dot(normal, -normalize(g_PlanetPosition)));

    float u = 0.5 + atan2(normal.z, normal.x) / (2 * PI);
    float v = 1 - acos(normal.y) / PI;

    float3 planetColor = g_PlanetTex.SampleLevel(my_linear_clamp_sampler, float2(u, v), 0);

    color += planetColor * lightColor * transmittance;

    // The planet is opaque
    transmittance = 0;
}

float3 GetAccelerationState(float3 pos, float3 vel)
{
    float3 L = cross(pos, vel);
    float h2 = dot(L, L);
    float r = length(pos);
    float r2 = r * r;
    float r5 = r2 * r2 * r;
    return pos * (-1.5f * kRs * h2 / r5);
}

// Step size shrinks near the photon sphere (r = 1.5*Rs).
float GetStepSize(float3 pos)
{
    float r = length(pos);

    float t = saturate((r - 1.5f * kRs) / (kAccretionEnd - 1.5f * kRs));

    return lerp(kStepMin, kStepMax, t);
}

// Advances (pos, vel) by one classical RK4 step of length stepSize along the null geodesic.
void RK4Step(inout float3 pos, inout float3 vel, float stepSize)
{
    float3 k1v = GetAccelerationState(pos, vel);
    float3 k1p = vel;

    float3 p2 = pos + 0.5f * stepSize * k1p;
    float3 v2 = vel + 0.5f * stepSize * k1v;
    float3 k2v = GetAccelerationState(p2, v2);
    float3 k2p = v2;

    float3 p3 = pos + 0.5f * stepSize * k2p;
    float3 v3 = vel + 0.5f * stepSize * k2v;
    float3 k3v = GetAccelerationState(p3, v3);
    float3 k3p = v3;

    float3 p4 = pos + stepSize * k3p;
    float3 v4 = vel + stepSize * k3v;
    float3 k4v = GetAccelerationState(p4, v4);
    float3 k4p = v4;

    pos += (stepSize / 6.0f) * (k1p + 2.0f * k2p + 2.0f * k3p + k4p);
    vel += (stepSize / 6.0f) * (k1v + 2.0f * k2v + 2.0f * k3v + k4v);
}

[numthreads(8, 8, 1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= g_CameraResX || id.y >= g_CameraResY)
        return;

    uint2 launchIndex = uint2(id.x, g_CameraResY - id.y - 1);
    uint2 launchDim = uint2(g_CameraResX, g_CameraResY);

    // Shoot rays through the center of a pixel.
    float2 frameCoord = launchIndex + float2(0.5, 0.5);

    float2 ndcCoords = frameCoord / float2(launchDim.x - 1, launchDim.y - 1);

    // Transform in [-1, 1] and apply perspective.
    ndcCoords = ndcCoords * 2 - float2(1, 1);
    ndcCoords = ndcCoords * g_Zoom;

    // Get a ray in view space.
    float3 viewDirection = normalize(float3(ndcCoords.x * g_AspectRatio, ndcCoords.y, 1));

    // Rotate the ray from view space to world space.
    float3 rayDirection = mul((float3x3) unity_CameraToWorld, viewDirection);

    float3 pos = g_CameraPos;

    float3 vel = rayDirection;

    float transmittance = 1.0f;

    float3 color = float3(0, 0, 0);

    // Calculate the trajectory (null geodesic) of the photon around the black hole
    // Variable-step RK4 integration of the photon's null geodesic to have variable step size and better performance.
    // The step size is bigger far from the black hole and smaller near the photon sphere (r = 1.5*Rs) where the curvature is stronger.
    for (uint i = 0; i < kMaxSteps; i++)
    {
        float r2 = dot(pos, pos);

        // Photon crossed the event horizon
        if (r2 < kRs * kRs)
        {
            g_Output[launchIndex] = float4(color, 1);
            return;
        }

        // Far field escape. Geodesic is almost straight, sample cubemap directly.
        if (r2 > kMaxRadius * kMaxRadius)
        {
            color += g_EnvTex.SampleLevel(sampler_g_EnvTex, vel, 0).rgb * transmittance;
            g_Output[launchIndex] = float4(color, 1);
            return;
        }

        float3 prevPos = pos;

        float stepSize = GetStepSize(pos);

        RK4Step(pos, vel, stepSize);

        SampleAccretionDisk(pos, prevPos, color, transmittance);

        // Miller's Planet is the fictional water world from Interstellar.
        SampleMillersPlanet(pos, prevPos, color, transmittance);

        if (transmittance < kTransmittanceLowerThreshold)
        {
            g_Output[launchIndex] = float4(color, 1);
            return;
        }
    }

    color += g_EnvTex.SampleLevel(sampler_g_EnvTex, vel, 0).rgb * transmittance;

    g_Output[launchIndex] = float4(color, 1);

}
